# SRUN PARAMETERS
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --exclusive
#EXPORT OMP_NUM_THREADS=1

&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME PBE
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER BFGS
    MAX_ITER 1
  &END GEO_OPT
  &CELL_OPT
    OPTIMIZER BFGS
    MAX_ITER 1
    TYPE DIRECT_CELL_OPT
    KEEP_ANGLES .TRUE.
    KEEP_SYMMETRY .TRUE.
  &END CELL_OPT
&END MOTION
&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    POTENTIAL_FILE_NAME POTENTIAL
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ADMM
    BASIS_SET_FILE_NAME BASIS_ADMM_MOLOPT
    &XC
     &XC_FUNCTIONAL
       &PBE
         SCALE_C 1
       &END PBE
     &END XC_FUNCTIONAL
    &END XC
    &SCF
      MAX_SCF 1
      EPS_SCF 1.0E-6
      SCF_GUESS RESTART
      IGNORE_CONVERGENCE_FAILURE 
      &OT T
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF T
        EPS_SCF 1.0E-6
        MAX_SCF 1
      &END OUTER_SCF
    &END SCF
    &QS
      MIN_PAIR_LIST_RADIUS -1
      METHOD GPW
    &END QS
    &MGRID
      CUTOFF 650
      REL_CUTOFF 70
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &MO_CUBES
        WRITE_CUBE TRUE
        NLUMO 5
        NHOMO 5
      &END MO_CUBES
      &PDOS
        NLUMO 10
      &END PDOS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 4.182518127399998 0.0 0.0
      B 0.0 15.9637815922 0.0
      C 0.0 0.0 6.3805804287
      ABC 12.735963 15.226382 19.492328
      ALPHA_BETA_GAMMA 90.0  90.0  90.0
      PERIODIC XYZ
    &END CELL
