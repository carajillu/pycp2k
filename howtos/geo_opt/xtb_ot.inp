&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME xtb_ot
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER BFGS
    MAX_ITER 200
    MAX_FORCE 0.00045
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD QS
  &DFT
    UKS FALSE
    CHARGE 0
    &SCF
      MAX_SCF 20
      EPS_SCF 1e-06
      SCF_GUESS RESTART
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
        EPS_SCF 1e-06
        MAX_SCF 2
      &END OUTER_SCF
    &END SCF
    &QS
      METHOD XTB
      &XTB
        DO_EWALD TRUE
        USE_HALOGEN_CORRECTION TRUE
        CHECK_ATOMIC_CHARGES FALSE
      &END XTB
    &END QS
  &END DFT
  &SUBSYS
    &CELL
      A 5.4306975 0.0 0.0
      B 0.0 5.4306975 0.0
      C 0.0 0.0 5.4306975
      PERIODIC XYZ
    &END CELL
    &COORD
      Si 0.0 0.0 0.0
      Si 1.357674375 1.357674375 1.357674375
      Si 2.71534875 2.71534875 0.0
      Si 4.073023125 4.073023125 1.357674375
      Si 2.71534875 0.0 2.71534875
      Si 4.073023125 1.357674375 4.073023125
      Si 0.0 2.71534875 2.71534875
      Si 1.357674375 4.073023125 4.073023125
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
